# Node dependencies
node_modules/
**/node_modules/

# Next.js build output
.next/
**/.next/
out/
build/
dist/

# Large Kiwix & ZIM archives (exceeds GitHub 100MB file limit)
*.zim
**/*.zim
kiwix/*.exe
kiwix/*.dll

# SQLite journals & temporary files
*.db-journal
*.db-wal
*.db-shm

# Environment & local credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
